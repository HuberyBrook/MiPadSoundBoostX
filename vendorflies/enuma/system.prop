# Memory Management (2)
aaudio.mmap_policy=2
aaudio.mmap_exclusive_policy=3

# Audio Processing (5)
vendor.audio.spkr_prot.tx.sampling_rate=96000
vendor.audio_hal.period_multiplier=3
vendor.audio.adm.buffering.ms=6
ro.vendor.audio.sfx.earadj=true
ro.vendor.audio.sfx.scenario=true

# Low Power Management (4)
vendor.audio.lowpower=false
ro.vendor.audio.soundtrigger.lowpower=false
persist.vendor.audio.bcl.enabled=false
persist.vendor.audio.ras.enabled=false

# Legacy Compatibility (1)
persist.vendor.audio.misoundasc=false

# System Debug & Interfaces (3)
ro.vendor.audio.dump.mixer=true
ro.audio.usb.period_us=0
ro.vendor.audio.soundfx.usb=false

# Codec Configuration (3)
vendor.audio.use.sw.alac.decoder=false
vendor.audio.use.sw.ape.decoder=false
vendor.audio.use.sw.mpegh.decoder=false

# Bluetooth & AAC Control (3)
persist.vendor.qcom.bluetooth.aac_frm_ctl.enabled=false
ro.persist.vendor.bt.aac_vbr_frm_ctl.enabled=true
ro.vendor.audio.misound.bluetooth.enable=false

# Core Features (7)
vendor.audio.feature.hifi_audio.enable=true
vendor.audio.feature.ras.enable=false
vendor.audio.feature.src_trkn.enable=false
ro.vendor.audio.aiasst.support=true
vendor.audio.tunnel.encode=true
audio.deep_buffer.media=true
ro.vendor.audio.sfx.harmankardon=true

# Hardware Offload & PCM Support (15)
vendor.audio.offload.gapless.enabled=true
vendor.audio.offload.track.enable=true
vendor.audio.offload.multiple.enabled=true
vendor.audio.offload.passthrough=true
audio.offload.pcm.enable=true
audio.offload.pcm.16bit.enable=true
audio.offload.pcm.24bit.enable=true
audio.offload.pcm.32bit.enable=true
audio.offload.pcm.float.enable=true
persist.audio.format.24bit=true
persist.audio.format.32bit=true
persist.audio.format.float=true
persist.vendor.audio.format.24bit=true
persist.vendor.audio.format.32bit=true
persist.vendor.audio.format.float=true